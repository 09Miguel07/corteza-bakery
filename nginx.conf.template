server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # La API vive en otro servicio; el front la llama siempre por /api (mismo origen, sin CORS).
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    # $proxy_host = host del API_UPSTREAM; necesario cuando la API está en otro dominio (Container Apps, ECS, App Runner).
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # Sondeo de salud para Docker / Kubernetes / la nube.
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  # Archivos con hash en el nombre: caché larga.
  location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Angular router: cualquier ruta devuelve index.html.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
